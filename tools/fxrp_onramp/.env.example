# XRP on-ramp — environment template.
#
# Copy to `.env` and fill in. `.env` is gitignored; never commit it.
# The seed is read from the environment only — the scripts never write it
# anywhere, never log it, and never take it as a command-line argument.

# ── XRPL (the XRP you are converting) ────────────────────────────────────────
# Mainnet: https://xrplcluster.com     Testnet: https://s.altnet.rippletest.net:51234
XRPL_RPC_URL=https://xrplcluster.com
# XRPL family seed of the wallet holding the XRP. Required only for --broadcast.
XRPL_SEED=

# ── Flare (where FXRP is minted) ─────────────────────────────────────────────
# mainnet | coston2
FLARE_NETWORK=mainnet
FLARE_RPC_URL=https://flare-api.flare.network/ext/C/rpc
# A Flare EOA whose PRIVATE KEY YOU HOLD. Do not use an exchange deposit address
# or the Derive owner address — those cannot spend the minted FXRP.
FLARE_RECIPIENT=
# Net XRP to convert. The mint + executor fees are added on top of this.
MINT_AMOUNT_XRP=30
